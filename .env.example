# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SISTEMA DE GESTÃO DE FUNIL E DIAGNÓSTICOS DE EVENTOS
# ==============================================================================
# REGRA DE SEGURANÇA:
# - Variáveis marcadas como [SECRET / SERVER-ONLY] JAMAIS devem receber prefixos
#   como VITE_, NEXT_PUBLIC_ ou EXPO_PUBLIC_, pois isso as embutiria no bundle
#   JavaScript enviado ao navegador.
# - Copie este arquivo para `.env` e preencha com valores fortes antes do deploy.
# ==============================================================================

# ------------------------------------------------------------------------------
# [SERVER / INFRAESTRUTURA] Configurações gerais da API Node.js/Express
# ------------------------------------------------------------------------------
PORT=8080
NODE_ENV=production

# ------------------------------------------------------------------------------
# [SECRET / SERVER-ONLY] Banco de Dados PostgreSQL
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=app_evento_user
DB_PASSWORD=***SUBSTITUA_POR_SENHA_FORTE_DO_BANCO***
DB_NAME=eventfunnel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=***SUBSTITUA_POR_SENHA_ADMIN_POSTGRES***
POSTGRES_DB=eventfunnel
DATABASE_URL=postgresql://app_evento_user:***SENHA***@postgres:5432/eventfunnel

# ------------------------------------------------------------------------------
# [SECRET / SERVER-ONLY] Cache e Locks Distribuídos (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# [SECRET / SERVER-ONLY] Autenticação JWT e Assinatura de Webhooks de Pagamento
# ------------------------------------------------------------------------------
JWT_SECRET=***GERE_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES_HEX***
PAYMENT_WEBHOOK_SECRET=***SEGREDO_HMAC_DO_GATEWAY_STRIPE_OU_MERCADOPAGO***

# ------------------------------------------------------------------------------
# [PUBLIC / FRONTEND] Variáveis seguras expostas ao navegador (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=/api
